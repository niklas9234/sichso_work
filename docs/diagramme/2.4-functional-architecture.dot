digraph FinSec {
    graph [rankdir=TB, splines=line, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.75,
           fontname="DejaVu Sans", label="FinSec · Funktionale Architektur", labelloc=t]
    node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#64748b",
          fontname="DejaVu Sans", fontsize=11, margin="0.18,0.12"]
    edge [color="#475569", fontcolor="#334155", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7]

    frontend [label="FinSec-Frontend (Browser)"]
    bank [label="EuroTrust", fillcolor="#fff7ed"]

    subgraph cluster_backend {
        label="FinSec-Backend"
        labeljust=l
        labelloc=b
        color="#94a3b8"
        style=rounded
        margin=20

        auth [label="FinSec-Anmeldung und Sitzungsprüfung", fillcolor="#eef2ff"]
        analysis [label="Finanzdatenverarbeitung\nTemporäre Auswertung"]
        accounts [label="Bankkontenverwaltung"]
        payments [label="Zahlungsverwaltung"]
        adapter [label="Bankanbindung"]

        subgraph {
            node [shape=cylinder, style=filled, fillcolor="#eff6ff"]
            login [label="FinSec-Nutzerkonten\nund Sitzungen"]
            links [label="Bankverbindungen\nund Einwilligungen"]
            orders [label="Offene FinSec-\nZahlungsaufträge"]
            refresh [label="Langlebige Bankzugangsmittel"]
        }

        {rank=same; login; auth}
        {rank=same; analysis; accounts; payments}
        {rank=same; links; adapter; orders}
        auth -> login
        auth -> {analysis accounts payments}
        analysis -> accounts [label="Kontodaten für Auswertung"]
        accounts -> links
        payments -> links [label="Zuordnung lesen"]
        payments -> orders
        accounts -> adapter [label="Verknüpfen / Abruf"]
        payments -> adapter [label="Zahlung / Status"]
        adapter -> refresh
    }

    frontend -> auth [xlabel="Login / Sitzungsnachweis"]
    adapter -> bank [xlabel="Bank-API"]
    frontend -> bank [label="SCA im Browser", style=dashed, weight=12]
}
