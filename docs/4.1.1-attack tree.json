{
  "securityObjective": "The system shall provide the confidentiality of account information such as balances and transactions",
  "root": {
    "id": "root",
    "label": "Unberechtigte Partei erhält\nKontostände oder Transaktionen",
    "gate": "OR",
    "children": [
      {
        "id": "session",
        "label": "Fremde FinSec-Sitzung\nfür ein verknüpftes Konto",
        "gate": "OR",
        "children": [
          {
            "id": "login",
            "label": "FinSec stellt nach Annahme\nfremdgenutzter Login-Nachweise\neine neue Sitzung aus"
          },
          {
            "id": "session_proof",
            "label": "Ein offengelegter Sitzungsnachweis\nwird noch akzeptiert"
          }
        ]
      },
      {
        "id": "wrong_account",
        "label": "FinSec liefert Daten eines\nfremden Bankkontos",
        "gate": "AND",
        "children": [
          {
            "id": "own_session",
            "label": "FinSec akzeptiert die eigene Sitzung\nder anfragenden Person"
          },
          {
            "id": "binding",
            "label": "Bankanbindung lässt den Abruf\ntrotz fehlender Kontozuordnung zu"
          }
        ]
      },
      {
        "id": "bank",
        "label": "Unberechtigter Abruf\nüber die EuroTrust-API",
